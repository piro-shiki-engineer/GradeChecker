{
    "compilerOptions": {
        "target": "ES6",
        "module": "None",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "outDir": "dist",
        "typeRoots": ["node_modules/@types"],
        "lib": ["DOM", "ESNext"]
    },
    "include": ["src/**/*", "popup/**/*"],
    "exclude": ["node_modules", "dist"]
}